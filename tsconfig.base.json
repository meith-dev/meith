{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,

    "baseUrl": ".",
    "paths": {
      "@meith/core": ["packages/core/src/index.ts"],
      "@meith/core/*": ["packages/core/src/*"],
      "@meith/db": ["packages/db/src/index.ts"],
      "@meith/demo": ["packages/demo/src/index.ts"],
      "@meith/demo/*": ["packages/demo/src/*"],
      "@meith/drafts": ["packages/drafts/src/index.ts"],
      "@meith/db/*": ["packages/db/src/*"],
      "@meith/drivers": ["packages/drivers/src/index.ts"],
      "@meith/drivers/images": ["packages/drivers/src/images/index.ts"],
      "@meith/drivers/*": ["packages/drivers/src/*"],
      "@meith/events": ["packages/events/src/index.ts"],
      "@meith/events/*": ["packages/events/src/*"],
      "@meith/search": ["packages/search/src/index.ts"],
      "@meith/settings": ["packages/settings/src/index.ts"],
      "@meith/subscriptions": ["packages/subscriptions/src/index.ts"],
      "@meith/search/*": ["packages/search/src/*"],
      "@meith/settings/*": ["packages/settings/src/*"],
      "@meith/tasks": ["packages/tasks/src/index.ts"],
      "@meith/runtime": ["packages/runtime/src/index.ts"],
      "@meith/tasks/*": ["packages/tasks/src/*"],
      "@meith/accounts": ["packages/accounts/src/index.ts"],
      "@meith/accounts/*": ["packages/accounts/src/*"],
      "@meith/antispam": ["packages/antispam/src/index.ts"],
      "@meith/antispam/*": ["packages/antispam/src/*"],
      "@meith/groups": ["packages/groups/src/index.ts"],
      "@meith/groups/*": ["packages/groups/src/*"],
      "@meith/attachments": ["packages/attachments/src/index.ts"],
      "@meith/attachments/*": ["packages/attachments/src/*"],
      "@meith/avatars": ["packages/avatars/src/index.ts"],
      "@meith/avatars/*": ["packages/avatars/src/*"],
      "@meith/authorization": ["packages/authorization/src/index.ts"],
      "@meith/authorization/*": ["packages/authorization/src/*"],
      "@meith/forums": ["packages/forums/src/index.ts"],
      "@meith/forums/*": ["packages/forums/src/*"],
      "@meith/threads": ["packages/threads/src/index.ts"],
      "@meith/threads/*": ["packages/threads/src/*"],
      "@meith/moderation": ["packages/moderation/src/index.ts"],
      "@meith/notifications": ["packages/notifications/src/index.ts"],
      "@meith/moderation/*": ["packages/moderation/src/*"],
      "@meith/posts": ["packages/posts/src/index.ts"],
      "@meith/profile-fields": ["packages/profile-fields/src/index.ts"],
      "@meith/messages": ["packages/messages/src/index.ts"],
      "@meith/relations": ["packages/relations/src/index.ts"],
      "@meith/reputation": ["packages/reputation/src/index.ts"],
      "@meith/polls": ["packages/polls/src/index.ts"],
      "@meith/signatures": ["packages/signatures/src/index.ts"],
      "@meith/admin": ["packages/admin/src/index.ts"],
      "@meith/posts/*": ["packages/posts/src/*"],
      "@meith/markdown": ["packages/markdown/src/index.ts"],
      "@meith/markdown/*": ["packages/markdown/src/*"],
      "@meith/plugin-dues": ["plugins/dues/src/index.ts"],
      "@meith/plugin-dues/*": ["plugins/dues/src/*"],
      "@meith/plugin-reference": ["plugins/reference/src/index.ts"],
      "create-meith": ["packages/create-meith/src/index.ts"],
      "@meith/import": ["packages/import/src/index.ts"],
      "@meith/upgrade": ["packages/upgrade/src/index.ts"],
      "@meith/install": ["packages/install/src/index.ts"],
      "@meith/api": ["packages/api/src/index.ts"],
      "@meith/api/*": ["packages/api/src/*"],
      "@meith/plugin-kit": ["packages/plugin-kit/src/index.ts"],
      "@meith/plugin-kit/*": ["packages/plugin-kit/src/*"],
      "@meith/theme-kit": ["packages/theme-kit/src/index.ts"],
      "@meith/theme-kit/*": ["packages/theme-kit/src/*"],
      "@meith/ui": ["packages/ui/src/index.ts"],
      "@meith/ui/*": ["packages/ui/src/*"],
      "@meith/shared": ["packages/shared/src/index.ts"],
      "@meith/shared/*": ["packages/shared/src/*"],
      "@meith/testkit": ["packages/testkit/src/index.ts"],
      "@meith/testkit/*": ["packages/testkit/src/*"],
      "@meith/theme-default": ["themes/default/src/index.ts"],
      "@meith/theme-default/*": ["themes/default/src/*"],
      "@meith/theme-midnight": ["themes/midnight/src/index.ts"],
      "@meith/theme-midnight/*": ["themes/midnight/src/*"],
      "@meith/example-plugin-hello": ["examples/hello-plugin/src/index.ts"],
      "@meith/example-plugin-hello/*": ["examples/hello-plugin/src/*"],
      "@meith/example-theme-iris": ["examples/iris-theme/src/index.ts"],
      "@meith/example-theme-iris/*": ["examples/iris-theme/src/*"]
    }
  },
  "exclude": ["node_modules", "**/dist", "**/.next"]
}
