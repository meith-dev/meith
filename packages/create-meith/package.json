{
  "name": "create-meith",
  "version": "0.21.0",
  "description": "Scaffold a Meith board — npx create-meith <name> writes a workspace that depends on @meith/web and @meith/cli.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meith-dev/meith.git",
    "directory": "packages/create-meith"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "create-meith": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "build": "esbuild --bundle --platform=node --format=esm --target=node22 src/bin.ts --outfile=dist/bin.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
