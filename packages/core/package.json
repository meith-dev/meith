{
  "name": "@meith/core",
  "version": "0.10.0",
  "description": "Environment, logging, caching and errors — the base layer every Meith package stands on.",
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meith-dev/meith.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cache": "./src/cache.ts",
    "./errors": "./src/errors.ts",
    "./env": "./src/env.ts",
    "./env-files": "./src/env-files.ts",
    "./logger": "./src/logger.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.*",
    "!src/**/*.type-test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p ../../tsconfig.json --noEmit"
  },
  "dependencies": {
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
