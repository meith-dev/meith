{
  "name": "@meith/core",
  "version": "0.23.3",
  "description": "Environment, logging, caching and errors — the base layer every Meith package stands on.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meith-dev/meith.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cache": "./src/cache.ts",
    "./errors": "./src/errors.ts",
    "./env": "./src/env.ts",
    "./env-files": "./src/env-files.ts",
    "./logger": "./src/logger.ts",
    "./metrics": "./src/metrics.ts",
    "./tracing": "./src/tracing.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.*",
    "!src/**/*.type-test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p ../../tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
