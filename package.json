{
  "name": "meith",
  "version": "0.35.0",
  "license": "MIT",
  "packageManager": "pnpm@10.6.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @meith/web dev",
    "build": "pnpm --filter @meith/web build",
    "start": "pnpm --filter @meith/web start",
    "site:dev": "pnpm --filter @meith/site dev",
    "site:build": "pnpm --filter @meith/site build",
    "site:start": "pnpm --filter @meith/site start",
    "site:docs": "node scripts/site-docs.mjs",
    "site:docs:check": "node scripts/site-docs.mjs --check",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:app": "tsc -p apps/community/tsconfig.json --noEmit",
    "typecheck:site": "tsc -p apps/web/tsconfig.json --noEmit",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps boards packages themes plugins examples",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "pnpm test:e2e:build && playwright test",
    "test:e2e:build": "pnpm exec tsx e2e/support/board-build.ts",
    "site:shots": "playwright test --config e2e/screenshot-site.config.ts",
    "meith": "pnpm --filter @meith/cli start",
    "format": "biome check --write .",
    "verify": "pnpm workspace:check && pnpm ci:parity:check && pnpm root:check && pnpm release:check && pnpm guards && pnpm guards:probe && pnpm i18n:check && pnpm slots:check && pnpm slots:probe && pnpm theme:docs:check && pnpm plugin:docs:check && pnpm board:gen:check && pnpm hooks:wired && pnpm regions:wired && pnpm api:docs:check && pnpm perf:docs:check && pnpm docs:index:check && pnpm docs:links:check && pnpm site:docs:check && pnpm marketplace:gen:check && pnpm board-installer:gen:check && pnpm templates:gen:check && pnpm extension:gen:check && pnpm lint && pnpm depcruise && pnpm typecheck && pnpm typecheck:app && pnpm typecheck:site && pnpm test",
    "workspace:check": "node scripts/workspace-check.mjs",
    "ci:parity:check": "node scripts/ci-parity-check.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:bump": "node scripts/release-bump.mjs",
    "root:check": "node scripts/root-check.mjs",
    "guards": "node scripts/guards.mjs",
    "guards:probe": "node scripts/guards-probe.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:baseline": "node scripts/i18n-check.mjs --write",
    "slots:check": "node scripts/slot-kinds.mjs",
    "slots:probe": "node scripts/slot-kinds.mjs --probe",
    "theme:docs": "node scripts/theme-api-docs.mjs",
    "theme:docs:check": "node scripts/theme-api-docs.mjs --check",
    "plugin:docs": "node scripts/plugin-hook-docs.mjs",
    "plugin:docs:check": "node scripts/plugin-hook-docs.mjs --check",
    "board:gen": "node scripts/board-plugins-gen.mjs",
    "board:gen:check": "node scripts/board-plugins-gen.mjs --check",
    "board:cli-tsconfig": "node scripts/board-cli-tsconfig.mjs",
    "hooks:wired": "node scripts/hook-callsites.mjs",
    "regions:wired": "node scripts/region-callsites.mjs",
    "api:docs": "tsx scripts/api-docs.mts",
    "api:docs:check": "tsx scripts/api-docs.mts --check",
    "docs:index:check": "node scripts/docs-index.mjs",
    "docs:links:check": "tsx scripts/docs-links.mts",
    "marketplace:gen": "node scripts/marketplace-gen.mjs",
    "marketplace:gen:check": "node scripts/marketplace-gen.mjs --check",
    "board-installer:gen": "tsx scripts/board-installer-gen.mts",
    "board-installer:gen:check": "tsx scripts/board-installer-gen.mts --check",
    "templates:gen": "tsx scripts/templates-gen.mts",
    "templates:gen:check": "tsx scripts/templates-gen.mts --check",
    "templates:sync": "tsx scripts/publish-templates.mts",
    "templates:sync:check": "tsx scripts/templates-in-sync.mts",
    "extension:gen": "tsx scripts/extension-scaffold-gen.mts",
    "extension:gen:check": "tsx scripts/extension-scaffold-gen.mts --check",
    "board:workspace:smoke": "tsx scripts/board-workspace-smoke.mts",
    "extension:workspace:smoke": "tsx scripts/extension-workspace-smoke.mts",
    "published:board:smoke": "tsx scripts/published-board-smoke.mts",
    "board:deploy-kit:smoke": "tsx scripts/board-deploy-kit-smoke.mts",
    "board:eject:smoke": "tsx scripts/board-eject-smoke.mts",
    "perf": "tsx packages/testkit/src/load/run.ts",
    "perf:docs": "node scripts/perf-docs.mjs",
    "perf:docs:check": "node scripts/perf-docs.mjs --check",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "comments:check": "node scripts/comment-check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@electric-sql/pglite": "^0.5.5",
    "@electric-sql/pglite-socket": "^0.2.8",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.2.0",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0"
  }
}
