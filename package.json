{
  "name": "meith",
  "version": "0.3.2",
  "license": "LGPL-3.0-or-later",
  "packageManager": "pnpm@10.6.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @meith/web dev",
    "build": "pnpm --filter @meith/web build",
    "start": "pnpm --filter @meith/web start",
    "site:dev": "pnpm --filter @meith/site dev",
    "site:build": "pnpm --filter @meith/site build",
    "site:start": "pnpm --filter @meith/site start",
    "site:docs": "node scripts/site-docs.mjs",
    "site:docs:check": "node scripts/site-docs.mjs --check",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:app": "tsc -p apps/community/tsconfig.json --noEmit",
    "typecheck:site": "tsc -p apps/web/tsconfig.json --noEmit",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps packages themes plugins examples",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "site:shots": "playwright test --config e2e/screenshot-site.config.ts",
    "community": "pnpm --filter @meith/cli start",
    "format": "prettier --write .",
    "verify": "pnpm workspace:check && pnpm root:check && pnpm release:check && pnpm guards && pnpm guards:probe && pnpm slots:check && pnpm slots:probe && pnpm theme:docs:check && pnpm plugin:docs:check && pnpm hooks:wired && pnpm api:docs:check && pnpm perf:docs:check && pnpm docs:index:check && pnpm site:docs:check && pnpm lint && pnpm depcruise && pnpm typecheck && pnpm typecheck:app && pnpm typecheck:site && pnpm test",
    "workspace:check": "node scripts/workspace-check.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:bump": "node scripts/release-bump.mjs",
    "root:check": "node scripts/root-check.mjs",
    "guards": "node scripts/guards.mjs",
    "guards:probe": "node scripts/guards-probe.mjs",
    "slots:check": "node scripts/slot-kinds.mjs",
    "slots:probe": "node scripts/slot-kinds.mjs --probe",
    "theme:docs": "node scripts/theme-api-docs.mjs",
    "theme:docs:check": "node scripts/theme-api-docs.mjs --check",
    "plugin:docs": "node scripts/plugin-hook-docs.mjs",
    "plugin:docs:check": "node scripts/plugin-hook-docs.mjs --check",
    "hooks:wired": "node scripts/hook-callsites.mjs",
    "api:docs": "node scripts/api-docs.mjs",
    "api:docs:check": "node scripts/api-docs.mjs --check",
    "docs:index:check": "node scripts/docs-index.mjs",
    "perf": "tsx packages/testkit/src/load/run.ts",
    "perf:docs": "node scripts/perf-docs.mjs",
    "perf:docs:check": "node scripts/perf-docs.mjs --check"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0"
  }
}
