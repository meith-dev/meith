{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "themes/**/*.ts",
    "themes/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "apps/cli/**/*.ts",
    "apps/worker/**/*.ts",
    "boards/**/*.ts",
    "e2e/**/*.ts",
    "*.ts",
    "*.mts"
  ],
  "exclude": ["node_modules", "**/dist", "**/.next", "**/.meith", "apps/community"]
}
