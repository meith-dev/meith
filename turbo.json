{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "tsconfig.base.json",
    ".dependency-cruiser.cjs",
    "biome.json",
    "scripts/no-group-ids.grit"
  ],
  "globalEnv": [
    "NODE_ENV",
    "DATA_SOURCE",
    "DATABASE_URL",
    "AUTH_SECRET",
    "TICK_SECRET",
    "CRON_SECRET",
    "QUEUE_DRIVER",
    "CACHE_DRIVER",
    "FILESTORE_DRIVER",
    "MAIL_DRIVER"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
