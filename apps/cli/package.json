{
  "name": "@meith/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "build": "esbuild --bundle --platform=node --format=cjs --target=node22 --external:@opentelemetry/api src/index.ts --outfile=dist/cli.cjs"
  },
  "bin": {
    "community": "./dist/index.js"
  },
  "dependencies": {
    "@meith/accounts": "workspace:*",
    "@meith/authorization": "workspace:*",
    "@meith/core": "workspace:*",
    "@meith/db": "workspace:*",
    "@meith/drivers": "workspace:*",
    "@meith/events": "workspace:*",
    "@meith/communities": "workspace:*",
    "@meith/profile-fields": "workspace:*",
    "@meith/settings": "workspace:*",
    "@meith/tasks": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.20.6"
  }
}
