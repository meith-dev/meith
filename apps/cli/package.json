{
  "name": "@meith/cli",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "build": "esbuild --bundle --platform=node --format=cjs --target=node22 --external:@opentelemetry/api --log-override:empty-import-meta=silent src/index.ts --outfile=dist/cli.cjs"
  },
  "bin": {
    "community": "./dist/index.js"
  },
  "dependencies": {
    "@meith/accounts": "workspace:*",
    "@meith/core": "workspace:*",
    "@meith/db": "workspace:*",
    "@meith/demo": "workspace:*",
    "@meith/drivers": "workspace:*",
    "@meith/forums": "workspace:*",
    "@meith/plugin-kit": "workspace:*",
    "@meith/profile-fields": "workspace:*",
    "@meith/runtime": "workspace:*",
    "@meith/settings": "workspace:*",
    "@meith/tasks": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.11"
  }
}
