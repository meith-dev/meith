{
  "name": "@meith/cli",
  "version": "0.20.0",
  "description": "The operator CLI: migrations, backup and restore, imports, users and settings — and the community bin that runs it against an external board workspace.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meith-dev/meith.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "bin": {
    "community": "./bin/community.mjs"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.type-test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "build": "esbuild --bundle --platform=node --format=cjs --target=node22 --log-override:empty-import-meta=silent src/index.ts --outfile=dist/cli.cjs"
  },
  "dependencies": {
    "@meith/accounts": "workspace:*",
    "@meith/core": "workspace:*",
    "@meith/db": "workspace:*",
    "@meith/demo": "workspace:*",
    "@meith/drivers": "workspace:*",
    "@meith/forums": "workspace:*",
    "@meith/plugin-kit": "workspace:*",
    "@meith/profile-fields": "workspace:*",
    "@meith/runtime": "workspace:*",
    "@meith/settings": "workspace:*",
    "@meith/tasks": "workspace:*",
    "create-meith": "workspace:*",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
