{
  "name": "@forum/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "esbuild --bundle --platform=node --format=cjs --target=node22 --external:@opentelemetry/api src/index.ts --outfile=dist/worker.cjs && esbuild --bundle --platform=node --format=cjs --target=node22 --external:@opentelemetry/api src/migrate.ts --outfile=dist/migrate.cjs"
  },
  "dependencies": {
    "@forum/core": "workspace:*",
    "@forum/drivers": "workspace:*",
    "@forum/runtime": "workspace:*",
    "@forum/tasks": "workspace:*",
    "@forum/db": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2"
  }
}
