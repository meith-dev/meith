{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@forum/core": ["../../packages/core/src/index.ts"],
      "@forum/core/*": ["../../packages/core/src/*"],
      "@forum/db": ["../../packages/db/src/index.ts"],
      "@forum/db/*": ["../../packages/db/src/*"],
      "@forum/drivers": ["../../packages/drivers/src/index.ts"],
      "@forum/drivers/*": ["../../packages/drivers/src/*"],
      "@forum/events": ["../../packages/events/src/index.ts"],
      "@forum/events/*": ["../../packages/events/src/*"],
      "@forum/settings": ["../../packages/settings/src/index.ts"],
      "@forum/settings/*": ["../../packages/settings/src/*"],
      "@forum/tasks": ["../../packages/tasks/src/index.ts"],
      "@forum/tasks/*": ["../../packages/tasks/src/*"],
      "@forum/accounts": ["../../packages/accounts/src/index.ts"],
      "@forum/accounts/*": ["../../packages/accounts/src/*"],
      "@forum/groups": ["../../packages/groups/src/index.ts"],
      "@forum/groups/*": ["../../packages/groups/src/*"],
      "@forum/authorization": ["../../packages/authorization/src/index.ts"],
      "@forum/authorization/*": ["../../packages/authorization/src/*"],
      "@forum/forums": ["../../packages/forums/src/index.ts"],
      "@forum/forums/*": ["../../packages/forums/src/*"],
      "@forum/threads": ["../../packages/threads/src/index.ts"],
      "@forum/threads/*": ["../../packages/threads/src/*"],
      "@forum/posts": ["../../packages/posts/src/index.ts"],
      "@forum/posts/*": ["../../packages/posts/src/*"],
      "@forum/theme-kit": ["../../packages/theme-kit/src/index.ts"],
      "@forum/theme-kit/*": ["../../packages/theme-kit/src/*"],
      "@forum/ui": ["../../packages/ui/src/index.ts"],
      "@forum/ui/*": ["../../packages/ui/src/*"],
      "@forum/shared": ["../../packages/shared/src/index.ts"],
      "@forum/shared/*": ["../../packages/shared/src/*"],
      "@forum/theme-default": ["../../themes/default/src/index.ts"],
      "@forum/theme-default/*": ["../../themes/default/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../../packages/**/*.ts",
    "../../packages/**/*.tsx",
    "../../themes/**/*.ts",
    "../../themes/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
