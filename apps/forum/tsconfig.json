{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@forum/core": ["../../packages/core/src/index.ts"],
      "@forum/core/*": ["../../packages/core/src/*"],
      "@forum/db": ["../../packages/db/src/index.ts"],
      "@forum/db/*": ["../../packages/db/src/*"],
      "@forum/drivers": ["../../packages/drivers/src/index.ts"],
      "@forum/drivers/images": ["../../packages/drivers/src/images/index.ts"],
      "@forum/drivers/*": ["../../packages/drivers/src/*"],
      "@forum/events": ["../../packages/events/src/index.ts"],
      "@forum/events/*": ["../../packages/events/src/*"],
      "@forum/search": ["../../packages/search/src/index.ts"],
      "@forum/settings": ["../../packages/settings/src/index.ts"],
      "@forum/subscriptions": ["../../packages/subscriptions/src/index.ts"],
      "@forum/search/*": ["../../packages/search/src/*"],
      "@forum/settings/*": ["../../packages/settings/src/*"],
      "@forum/tasks": ["../../packages/tasks/src/index.ts"],
      "@forum/runtime": ["../../packages/runtime/src/index.ts"],
      "@forum/tasks/*": ["../../packages/tasks/src/*"],
      "@forum/accounts": ["../../packages/accounts/src/index.ts"],
      "@forum/accounts/*": ["../../packages/accounts/src/*"],
      "@forum/groups": ["../../packages/groups/src/index.ts"],
      "@forum/groups/*": ["../../packages/groups/src/*"],
      "@forum/attachments": ["../../packages/attachments/src/index.ts"],
      "@forum/attachments/*": ["../../packages/attachments/src/*"],
      "@forum/avatars": ["../../packages/avatars/src/index.ts"],
      "@forum/avatars/*": ["../../packages/avatars/src/*"],
      "@forum/authorization": ["../../packages/authorization/src/index.ts"],
      "@forum/authorization/*": ["../../packages/authorization/src/*"],
      "@forum/forums": ["../../packages/forums/src/index.ts"],
      "@forum/forums/*": ["../../packages/forums/src/*"],
      "@forum/threads": ["../../packages/threads/src/index.ts"],
      "@forum/threads/*": ["../../packages/threads/src/*"],
      "@forum/moderation": ["../../packages/moderation/src/index.ts"],
      "@forum/notifications": ["../../packages/notifications/src/index.ts"],
      "@forum/moderation/*": ["../../packages/moderation/src/*"],
      "@forum/posts": ["../../packages/posts/src/index.ts"],
      "@forum/profile-fields": ["../../packages/profile-fields/src/index.ts"],
      "@forum/messages": ["../../packages/messages/src/index.ts"],
      "@forum/relations": ["../../packages/relations/src/index.ts"],
      "@forum/reputation": ["../../packages/reputation/src/index.ts"],
      "@forum/signatures": ["../../packages/signatures/src/index.ts"],
      "@forum/admin": ["../../packages/admin/src/index.ts"],
      "@forum/posts/*": ["../../packages/posts/src/*"],
      "@forum/bbcode": ["../../packages/bbcode/src/index.ts"],
      "@forum/bbcode/*": ["../../packages/bbcode/src/*"],
      "@forum/plugin-reference": ["../../plugins/reference/src/index.ts"],
      "@forum/import": ["../../packages/import/src/index.ts"],
      "@forum/upgrade": ["../../packages/upgrade/src/index.ts"],
      "@forum/install": ["../../packages/install/src/index.ts"],
      "@forum/api": ["../../packages/api/src/index.ts"],
      "@forum/api/*": ["../../packages/api/src/*"],
      "@forum/plugin-kit": ["../../packages/plugin-kit/src/index.ts"],
      "@forum/plugin-kit/*": ["../../packages/plugin-kit/src/*"],
      "@forum/theme-kit": ["../../packages/theme-kit/src/index.ts"],
      "@forum/theme-kit/*": ["../../packages/theme-kit/src/*"],
      "@forum/ui": ["../../packages/ui/src/index.ts"],
      "@forum/ui/*": ["../../packages/ui/src/*"],
      "@forum/shared": ["../../packages/shared/src/index.ts"],
      "@forum/shared/*": ["../../packages/shared/src/*"],
      "@forum/theme-default": ["../../themes/default/src/index.ts"],
      "@forum/theme-default/*": ["../../themes/default/src/*"],
      "@forum/theme-midnight": ["../../themes/midnight/src/index.ts"],
      "@forum/theme-midnight/*": ["../../themes/midnight/src/*"],
      /*
       * Needed even though the app never imports it: this config compiles
       * `../../packages/**`, which includes package *tests*, and those import
       * the testkit. Without the alias, `typecheck:app` fails on a package test
       * for a module the app itself does not use.
       *
       * This list is a hand-maintained copy of tsconfig.base.json's — TypeScript
       * replaces `paths` rather than merging it, and this config needs its own
       * `@/*` and baseUrl. Adding a package means adding it in both places; the
       * failure mode is exactly this one.
       */
      "@forum/testkit": ["../../packages/testkit/src/index.ts"],
      "@forum/testkit/*": ["../../packages/testkit/src/*"]
    }
  },
  /*
   * `.next/types` is emitted by `next build` and validates route signatures, so
   * it is worth checking when present and matches nothing when absent.
   *
   * `.next/dev/types` is deliberately NOT here. It is dev-server output that no
   * step in `verify` regenerates, so after any route rename it holds dangling
   * references to files that no longer exist and fails `typecheck:app` for a
   * reason that has nothing to do with the source. A gate that breaks on a
   * stale artefact trains people to ignore it.
   */
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../../packages/**/*.ts",
    "../../packages/**/*.tsx",
    "../../themes/**/*.ts",
    "../../themes/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
