{
  "name": "@meith/web",
  "version": "0.21.0",
  "description": "The board itself: the Next.js app, and the forum-web bin that materializes it into an external board workspace.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meith-dev/meith.git",
    "directory": "apps/community"
  },
  "bin": {
    "forum-web": "./bin/forum-web.mjs"
  },
  "exports": {
    "./config": "./src/config.ts"
  },
  "files": [
    "bin",
    "app",
    "src",
    "public",
    "next.config.mjs",
    "postcss.config.mjs",
    "components.json",
    "instrumentation.ts",
    "proxy.ts",
    "!src/**/*.test.*",
    "!src/**/*.type-test.*",
    "!app/**/*.test.*",
    "!app/**/*.type-test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
