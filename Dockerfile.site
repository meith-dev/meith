# syntax=docker/dockerfile:1.7-labs
# meith.dev itself — the landing page and the documentation (`@meith/site`).
# Nothing in the self-hosting path uses this; Dockerfile builds the board.

FROM node:22-alpine AS deps
WORKDIR /repo

RUN corepack enable

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY --parents ./*/*/package.json ./

# This app's subtree only: the site depends on no @meith/* package.
RUN pnpm install --frozen-lockfile --filter @meith/site...

FROM deps AS build
WORKDIR /repo

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV SITE_STANDALONE=1

RUN pnpm --filter @meith/site build

FROM node:22-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3100
ENV HOSTNAME=0.0.0.0

RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001

COPY --from=build --chown=nextjs:nodejs /repo/apps/web/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=nextjs:nodejs /repo/apps/web/public ./apps/web/public

# /llms.txt and /docs/search-index.json read docs/ at request time, finding it
# by walking up for pnpm-workspace.yaml. Both are a 500 without these two.
COPY --from=build --chown=nextjs:nodejs /repo/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=build --chown=nextjs:nodejs /repo/docs ./docs

USER nextjs
EXPOSE 3100

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3100/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

CMD ["node", "apps/web/server.js"]
